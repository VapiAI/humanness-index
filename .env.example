# The Humanness Index: app environment.
# Copy to .env.local and fill in. EVERY variable is optional for local dev:
# with none set, the app runs an in-memory vote store seeded from the
# production export and plays audio from the public clip origin.
#
# Pipeline (clip generation / benchmarking) keys live separately in
# src/pipeline/.env.example.

# Signs single-use battle tokens (HMAC-SHA256). REQUIRED in production;
# falls back to a fixed dev-only secret locally.
HUMANNESS_BATTLE_TOKEN_SECRET=

# Vercel Blob store for the event-sourced vote store. Without it, votes go
# to process memory and reset on restart (fine for dev).
BLOB_READ_WRITE_TOKEN=

# Overrides the built-in audio origin (the public Blob host serving
# audio/{contentHash}.mp3). Set when pointing at a different clip store.
HUMANNESS_AUDIO_ORIGIN=

# Cloudflare Turnstile, the every-Nth-vote challenge. Set BOTH to activate;
# without them the gate no-ops and voting works as normal.
# REQUIRED in production: the vote endpoint is public and documented.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vote rate limiting is not configured here. It runs as Vercel Firewall rules
# on /api/vote, at the edge ahead of the function, so there is nothing to set
# locally and no in-process limiter to fool you into thinking it is on.

# PostHog analytics. Without the key, no analytics code loads at all
# (which also keeps forks clean). Host defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

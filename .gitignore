# dependencies
/node_modules

# next.js
/.next/
/out/

# testing
/coverage

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# env files: examples only, never real values
.env*
!.env.example
!src/pipeline/.env.example

# pipeline: local secrets, clone-id state, licensed audio + benchmark outputs.
# The clips and source voice masters are licensed recordings (see TRADEMARKS.md)
# and are never committed.
src/pipeline/.env
src/pipeline/voices.local.json
src/pipeline/results/

# Private registry overlay (SPEC 4.3): embargoed entries live only in the
# deploy environment. `bun install` generates the empty default.
src/catalog/overlay.local.ts
public/marks/local/

# Maintainer-local holding area (never shipped)
/private/

# Licensed Vapi brand fonts (Avantt, Season Sans, Foundry Gridnik): commercial
# typefaces, never committed to this open-source repo. Forks fall back to the
# bundled open fonts (Instrument Sans, Tomorrow) via the token stacks. The CLI
# uploads these to production via .vercelignore. The README is kept as docs;
# only the binaries are ignored.
public/fonts/brand/*.woff2
public/fonts/brand/*.otf

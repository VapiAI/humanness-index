# Humanness Index pipeline secrets. Maintainers pull these from the Vercel
# project's Development environment, where keys are added as each provider is
# needed:
#   vercel env pull src/pipeline/.env --environment=development --yes
# Provider keys: synthesis + voice cloning + TTFB benchmarking.
# Never commit the real .env; never print these values.

# Existing Index providers (new-model generation + bench)
# Standard name; the shared Development alias ELEVEN_LABS is also accepted.
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
# Optional; appended as ?GroupId= to MiniMax calls when set.
MINIMAX_GROUP_ID=
# Base64 Basic token (not a bare key).
INWORLD_API_KEY=
# Standard name; the shared Development alias CARTESIA is also accepted.
CARTESIA_API_KEY=
XAI_API_KEY=

# Expansion providers
# Project-scoped key approved for GPT-Live and recording-based custom voices.
# api.voices.read + api.voices.write; see GPT-LIVE.md for actor consents.
OPENAI_API_KEY=
# Required for project-bound local consent/clone receipts (never infer from login).
OPENAI_PROJECT_ID=
# Standard name; the shared Development alias MURF is also accepted.
MURF_API_KEY=
SMALLEST_AI_API_KEY=
NEUPHONIC_API_KEY=
HUME_API_KEY=
SESAME_API_KEY=
# Required for Sesame work: the privately hosted CSM-1B deployment URL
# (no public default exists; see transports/sesame.ts).
SESAME_URL=
# Bench only: S2.1-Pro's arena clips are vendor-rendered, so this key is used
# purely for the TTFB run. Needs API credit on the account: the paid s2.1-pro
# string 402s at a zero balance, and the free s2.1-pro-free string carries no
# TTFA guarantee, so it is not what the Index measures.
# https://fish.audio/app/api-keys
FISH_API_KEY=
# Bench only: Simba 3.2's arena clips are vendor-rendered, so this key is
# used purely for the TTFB run. https://platform.speechify.ai
SPEECHIFY_API_KEY=

# Vercel Blob store hosting the arena clips (audio/{hash}.mp3).
BLOB_READ_WRITE_TOKEN=

# Transcription (Human-baseline take segmentation; humanness:human-segment).
# Deepgram nova-3 word-level timestamps. https://console.deepgram.com
DEEPGRAM_API_KEY=

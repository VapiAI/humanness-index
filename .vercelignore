# Upload-exclusion list for `vercel --prod` (CLI deploys from this local dir).
#
# Mirrors .gitignore so a CLI upload matches a clean Git checkout: it never
# ships secrets or licensed binaries. (Vercel falls back to .gitignore only when
# no .vercelignore exists.) The licensed brand fonts are no longer uploaded with
# the build -- they're served from the project's Vercel Blob store (see
# src/styles/brand-fonts.css), so every deploy renders them the same way.

# dependencies / build output (Vercel installs + builds fresh)
node_modules
.next
out
coverage

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# vercel local link
.vercel

# env files: never upload local secrets (Vercel injects from project settings)
.env*

# pipeline: local secrets, clone-id state, licensed audio + benchmark outputs
src/pipeline/.env
src/pipeline/voices.local.json
src/pipeline/results/

# private registry overlay + local-only marks
src/catalog/overlay.local.ts
public/marks/local/

# maintainer-local holding area
private/

# licensed brand fonts: hosted on Vercel Blob, never uploaded with the build
public/fonts/brand/
